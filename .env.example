MODE=demo
OPENAI_API_KEY=replace-locally
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
APP_API_KEY=replace-with-random-operator-key
REVIEWER_API_KEY=replace-with-random-reviewer-key
ADMIN_API_KEY=replace-with-random-admin-key
POSTGRES_PASSWORD=replace-with-random-url-safe-password
# Generate three separate DB role passwords: python scripts/setup_db_credentials.py
# Host Python only: provision the portable DB explicitly; Compose builds its own DSNs.
DATABASE_URL=postgresql://rf_app:replace-with-app-password@127.0.0.1:55432/postgres
READONLY_DATABASE_URL=postgresql://rf_readonly:replace-with-readonly-password@127.0.0.1:55432/postgres
RETRIEVAL_MODE=bm25
SEMANTIC_WEIGHT=0.25
# Optional local encoder / pgvector settings: see SEMANTIC_IMPLEMENTATION.md.
